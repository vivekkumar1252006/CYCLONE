# Copy to .env and adjust. Never commit .env. No secret belongs in frontend code.

ENVIRONMENT=development

# Database: SQLite fallback by default. For PostgreSQL/PostGIS:
# DATABASE_URL=postgresql+psycopg2://cycloneguard:password@localhost:5432/cycloneguard
# POSTGRES_PASSWORD=change-me-locally          # used by docker-compose

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# When set, mutating endpoints require header X-API-Key (enter it in the UI Settings page).
# ADMIN_API_KEY=

MAX_UPLOAD_MB=5
VULN_MODEL_BACKEND=random_forest     # or xgboost (pip install xgboost, then: python -m ml.train --backend xgboost)
AUTO_SEED_DEMO=true                  # seed DEMO scenario ALPHA on first start

# ---- Live data providers (optional; the app falls back to demo data if unset/unavailable) ----
# JSON feed of cyclone tracks in the schema documented in docs/api.md
# CYCLONE_FEED_URL=
# CYCLONE_FEED_API_KEY=
# demo | openmeteo  (Open-Meteo needs no key; requires internet access)
WEATHER_PROVIDER=demo
# SATELLITE_PROVIDER_URL=
# SATELLITE_API_KEY=
PROVIDER_TIMEOUT_S=6
